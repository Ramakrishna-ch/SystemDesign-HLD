        <mxCell id="ukKPymGoxakO6xEEOk9w-29" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Architecture Design" vertex="1">
          <mxGeometry height="420" width="1120" x="20" y="370" as="geometry">
            <mxRectangle height="30" width="150" x="20" y="370" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ukKPymGoxakO6xEEOk9w-28" parent="ukKPymGoxakO6xEEOk9w-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="An optional Mq if data write thoughput increases" vertex="1">
          <mxGeometry height="30" width="150" x="595" y="87.8" as="geometry" />
        </mxCell>
        <mxCell id="OO_AXkMir4CHDQAmzkzZ-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;CAP:&lt;br&gt;Parition: needed cause when we scale to massive load system goes segregates&lt;/div&gt;&lt;div&gt;Availability: when part fails, some of the users may get the creates and reads from other available systems else error is shown.&lt;/div&gt;&lt;div&gt;Consistency: multiple ways of implementation there like if info is single replica not many then consistency wont matter, else users may see older data. if consistency imp then writes status must be shown to user if it is successful or not. also content hashing might be considered when dealing with diff in local and stored one, diff version when last save failed but local has updated content and user access same url somewhere else.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="OO_AXkMir4CHDQAmzkzZ-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="Text size limit: Initially data limit can be considered based on API req payload size which is dependency on server limits like 2mb for tomcat etc. so for this size limit mongo is enough. but we go large sizes write strategy changes like stream or upload and storage option jumps to s3 like ones. for faster retrieval we can use cdn for frequently accessed content with unique id as key.&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Using s3 or CDN like systems wont put much stress on read service memory cause content is directly served from s3 to browser.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="400" y="205" as="geometry" />
        </mxCell>
        <mxCell id="rG6B3M27jz7WGy7WSxZI-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="APIs" vertex="1">
          <mxGeometry height="420" width="1120" x="20" y="830" as="geometry">
            <mxRectangle height="30" width="150" x="20" y="370" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rG6B3M27jz7WGy7WSxZI-3" parent="rG6B3M27jz7WGy7WSxZI-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;align=left;" value="&lt;div&gt;CREATE PASTE:&lt;/div&gt;&lt;div&gt;POST /save&lt;/div&gt;&lt;div&gt;Payload: {content}&lt;/div&gt;&lt;div&gt;Response Body: {UniqueId, Full URL, Expiry}&lt;/div&gt;&lt;div&gt;Response messages: Success, Internal error, Bad Input(Invalid id), Size limit exceeded&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1100" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rG6B3M27jz7WGy7WSxZI-4" parent="rG6B3M27jz7WGy7WSxZI-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;align=left;" value="&lt;div&gt;RETRIEVE PASTE:&lt;/div&gt;&lt;div&gt;GET /{uniqueID - mandatory}&lt;/div&gt;&lt;div&gt;Payload: None&lt;br&gt;Response Body: plain or encoded content text, expiry&lt;/div&gt;&lt;div&gt;Response messages: Success, Internal error, Bad Input(Invalid id)&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="1100" x="10" y="200" as="geometry" />
        </mxCell>
